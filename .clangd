CompileFlags:
  CompilationDatabase: build/debug
  Add:
    - "-std=c++20"
    - "-Icrates/rusty/include"
    - "-Icrates/glvm/include"
    - "-Icrates/game/include"
  Remove:
    - "-fmodules-ts"
    - "-fmodule-mapper=*"
    - "-fdeps-format=*"
    - "-fdeps-file=*"
    - "-fmodule-output=*"
    - "-fdiagnostics-color=*"
    - "-MD"
    - "-MT*"
    - "-MF*"

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  ClangTidy:
    Remove:
      - misc-include-cleaner
