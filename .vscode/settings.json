{
    "clangd.arguments": [
        "--clang-tidy",
        "--background-index",
        "--header-insertion=never",
        "--compile-commands-dir=${workspaceFolder}/build/debug",
        "--log=verbose"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.codeAnalysis.clangTidy.enabled": false,
    "cmake.configureOnOpen": true,
    "C_Cpp.default.cppStandard": "c++26",
    "C_Cpp.default.cStandard": "c23",
    "cmake.ctest.parallelJobs": 0,
    "cmake.parallelJobs": 0,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "testExplorer.useNativeTesting": true,
    "C_Cpp.errorSquiggles": "enabled",
    "lldb.launch.env": {
        "_NO_DEBUG_HEAP": "1"
    },
    "cmake.configureSettings": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    },
    "[cmake]": {
        "editor.tabSize": 2
    },
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/.vscode": false
    },
    "files.associations": {
        "*.c": "c",
        "*.h": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "*.cmake": "cmake",
        "CMakeLists.txt": "cmake",
        "*.clang-format": "yaml",
        "*.clang-tidy": "yaml",
        "*.clangd": "yaml"
    },
    "cmake.debugConfig": {
        "MIMode": "gdb",
        "miDebuggerPath": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    },
    "cSpell.words": [
        "aabb",
        "Alsa",
        "archetyped",
        "asan",
        "attackable",
        "Bivector",
        "Bstatic",
        "bugprone",
        "CFLAGS",
        "chel",
        "chrono",
        "cofactors",
        "Constexpr",
        "cout",
        "cplusplus",
        "cppcoreguidelines",
        "Cramer's",
        "crosshairs",
        "ctest",
        "CXSCREEN",
        "CYSCREEN",
        "DCMAKE",
        "delinearize",
        "dfull",
        "dwmapi",
        "emitvertex",
        "EMSCRIPTEN",
