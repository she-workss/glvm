                "${default}",
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/build/**/_deps/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compileCommands": [
                "${workspaceFolder}/build/debug/compile_commands.json"
            ]
        },
        {
            "name": "Mac",
            "intelliSenseMode": "macos-clang-x64",
            "cStandard": "c23",
            "cppStandard": "c++26",
            "includePath": [
                "${default}",
