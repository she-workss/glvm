{
    "version": "0.2.0",
    "configurations": [
        // Examples:
        {
            "name": "Example: hello_world",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/examples/hello_world",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug",
            "miDebuggerPath": "gdb",
            "windows": {
                "program": "${workspaceFolder}/build/debug/examples/hello_world",
                "MIMode": "gdb",
                "miDebuggerPath": "gdb"
            }
        },
        // Tests:
        {
            "name": "Test: basic",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tests/basic",
            "args": [
                "--gtest_color=yes"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Debug",
            "windows": {
                "program": "${workspaceFolder}/build/debug/tests/basic"
            }
        },
        // Benchmarks:
        {
            "name": "Bench: ecs",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/benches/ecs",
            "args": [
                "--benchmark_color=true"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Release",
            "windows": {
                "program": "${workspaceFolder}/build/release/benches/ecs"
            }
        }
    ]
}
