{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "__build-debug",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "__build-release",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "__compiler-gcc",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "vendor": {
                "glvm:compiler": "gcc"
            }
        },
        {
            "name": "__compiler-clang",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "vendor": {
                "glvm:compiler": "clang"
            }
        },
        {
            "name": "__compiler-clang-cl",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_LINKER": "lldebug-link",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "ProgramDatabase",
                "CMAKE_RC_COMPILER": "rc",
                "CMAKE_NINJA_CMCLDEPS_RC": "OFF"
            },
            "vendor": {
                "glvm:compiler": "clang-cl"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "__compiler-msvc",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "ProgramDatabase",
                "CMAKE_RC_COMPILER": "rc",
                "CMAKE_NINJA_CMCLDEPS_RC": "OFF"
            },
            "vendor": {
                "glvm:compiler": "msvc"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build",
            "inherits": "__build-debug"
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Release build (Size optimized)",
            "inherits": "__build-release"
        },
        {
            "name": "debug-gcc",
            "displayName": "Debug (GCC)",
            "description": "Debug build (GCC)",
            "inherits": [
                "__build-debug",
                "__compiler-gcc"
            ],
            "vendor": {
                "glvm:compiler": "gcc"
            }
        },
        {
            "name": "debug-clang",
            "displayName": "Debug (Clang)",
            "description": "Debug build (Clang)",
            "inherits": [
                "__build-debug",
                "__compiler-clang"
            ],
            "vendor": {
                "glvm:compiler": "clang"
            }
        },
        {
            "name": "debug-clang-cl",
            "displayName": "Debug (Clang-CL)",
            "description": "Debug build (clang-cl + lldebug-link)",
            "inherits": [
                "__build-debug",
                "__compiler-clang-cl"
            ],
            "vendor": {
                "glvm:compiler": "clang-cl"
            }
        },
        {
            "name": "debug-msvc",
            "displayName": "Debug (MSVC)",
            "description": "Debug build (MSVC)",
            "inherits": [
                "__build-debug",
                "__compiler-msvc"
            ],
            "vendor": {
                "glvm:compiler": "msvc"
            }
        },
        {
            "name": "release-gcc",
            "displayName": "Release (GCC)",
            "description": "Release build (GCC)",
            "inherits": [
                "__build-release",
                "__compiler-gcc"
            ],
            "vendor": {
                "glvm:compiler": "gcc"
            }
        },
        {
            "name": "release-clang",
            "displayName": "Release (Clang)",
            "description": "Release build (Clang)",
            "inherits": [
                "__build-release",
                "__compiler-clang"
            ],
            "vendor": {
                "glvm:compiler": "clang"
            }
        },
        {
            "name": "release-clang-cl",
            "displayName": "Release (Clang-CL)",
            "description": "Release build (clang-cl + lldebug-link)",
            "inherits": [
                "__build-release",
                "__compiler-clang-cl"
            ],
            "vendor": {
                "glvm:compiler": "clang-cl"
            }
        },
        {
            "name": "release-msvc",
            "displayName": "Release (MSVC)",
            "description": "Release build (MSVC)",
            "inherits": [
                "__build-release",
                "__compiler-msvc"
            ],
            "vendor": {
                "glvm:compiler": "msvc"
            }
        },
        {
            "name": "profiling",
            "displayName": "Profiling",
            "description": "Release build with debug info",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS": "-g -fno-omit-frame-pointer",
                "GLVM_ENABLE_TRACY": "ON"
            }
        },
        {
            "name": "profiling-msvc",
            "displayName": "Profiling (MSVC)",
            "description": "Release build with debug info (MSVC)",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "ProgramDatabase",
                "GLVM_BUILD_BENCHES": "OFF",
                "GLVM_BUILD_DOCS": "OFF",
                "CMAKE_RC_COMPILER": "rc",
                "CMAKE_NINJA_CMCLDEPS_RC": "OFF"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug with AddressSanitizer",
            "description": "Debug build with address sanitizer",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ubsan",
            "displayName": "Debug with UBSanitizer",
            "description": "Debug build with undefined behavior sanitizer",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize=vptr -fno-omit-frame-pointer -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined -fno-sanitize=vptr"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
